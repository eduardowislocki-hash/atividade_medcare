create view vw_acervo_ordenado as
select
    livros.titulo,
    livros.isbn,
    categorias.nome as categoria,
    livros.taxa_diaria
from livros
inner join categorias
on livros.categoria_id = categorias.id
order by livros.taxa_diaria desc;

create view vw_emprestimos_gabriel as
select
    emprestimos.id as id_emprestimo,
    emprestimos.data_emprestimo,
    livros.titulo,
    itens_emprestimo.quantidade,
    emprestimos.status
from emprestimos
inner join leitores
on emprestimos.leitor_id = leitores.id
inner join itens_emprestimo
on emprestimos.id = itens_emprestimo.emprestimo_id
inner join livros
on itens_emprestimo.livro_id = livros.id
where leitores.nome = 'gabriel costa';

create view vw_total_emprestimos as
select
    emprestimos.id as id_emprestimo,
    leitores.nome as leitor,
    sum(itens_emprestimo.quantidade * itens_emprestimo.valor_diaria) as valor_total
from emprestimos
inner join leitores
on emprestimos.leitor_id = leitores.id
inner join itens_emprestimo
on emprestimos.id = itens_emprestimo.emprestimo_id
group by emprestimos.id, leitores.nome;

